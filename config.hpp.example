static constexpr size_t LOG_COMPACT_THRESHOLD = 4;

static constexpr std::chrono::milliseconds FLUSH_INTERVAL{1500};

static constexpr const char* LOG_FILE_PATH = "/root/raft/persistence/log";
static constexpr const char* METADATA_FILE_PATH = "/root/raft/persistence/metadata";
static constexpr const char* SNAPSHOT_FILE_PATH = "/root/raft/persistence/snapshot";
static constexpr const char* SNAPSHOT_TMP_FILE_PATH = "/root/raft/persistence/snapshot_tmp";
static constexpr const char* STATE_MACHINE_FILE_PATH = "/root/raft/persistence/state";
static constexpr const char* STATE_MACHINE_TMP_FILE_PATH = "/root/raft/persistence/state_tmp";

// The peer configuration is IDENTICAL on every node in the cluster. A peer's
// index in this array is its globally consistent NodeID. Each node lists
// ITSELF at index MY_ID using the empty placeholder "" in place of its own IP
// address; CreateNode skips that slot. Example for a 3-node cluster, as seen
// by every node (only MY_ID differs per node):
//
// The node with MY_ID == k must have "" at index k and real IPs elsewhere.
constexpr void setup_peers(const char** a) {
    a[0] = "172.26.0.10";
    a[1] = "172.26.0.11";
    a[2] = "172.26.0.12";
}
