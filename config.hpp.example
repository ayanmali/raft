static constexpr int BITS_PER_BYTE = 8;
static constexpr int BITS_PER_UINT64_T = 64;
static constexpr size_t CACHE_LINE_SIZE = std::hardware_destructive_interference_size;

static constexpr uint EVENT_LOOP_THREADS = 1;

constexpr int EPOLL_BATCH = 64; // max # of fds processed per loop iteration

static constexpr int MIN_ELECTION_TIMEOUT_MS = 150;
static constexpr int MAX_ELECTION_TIMEOUT_MS = 300;

static constexpr int BASE_CLUSTER_SIZE = 3;
static constexpr size_t MAX_NODES = BASE_CLUSTER_SIZE * 1.5;

static constexpr int MY_ID = 0;

// Heartbeat cadence (ms). Must be well under MIN_TIMEOUT_MS so followers see
// liveness before they bother starting an election; 1/3 of MIN_TIMEOUT_MS
// is a standard pick.
static constexpr uint64_t HEARTBEAT_INTERVAL_MS{MIN_ELECTION_TIMEOUT_MS / 3};
static constexpr uint64_t RPC_TIMEOUT_MS{MAX_ELECTION_TIMEOUT_MS * 3};

static constexpr int CMD_SIZE = 4; // # of bytes that each command in the log occupies
static constexpr int SNAPSHOT_CHUNK_SIZE = 2;

static constexpr const char* SERVER_PORT = "6969";
