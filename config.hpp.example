#pragma once

#define DEBUG

/*
initial IP addresses provided for bootstrapping
*/
#include <array>
#include <cstddef>
#include <cstdint>
#include <sys/types.h>

static constexpr size_t CACHE_LINE_SIZE = 64;

static constexpr uint EVENT_LOOP_THREADS = 1;

static constexpr uint MIN_ELECTION_TIMEOUT_MS = 150;
static constexpr uint MAX_ELECTION_TIMEOUT_MS = 300;

static constexpr size_t MAX_NODES = 100;

static constexpr int MY_ID = 0;

// Heartbeat cadence (ms). Must be well under MIN_TIMEOUT_MS so followers see
// liveness before they bother starting an election; 1/3 of MIN_TIMEOUT_MS
// is a standard pick.
static constexpr uint64_t HEARTBEAT_INTERVAL{MIN_ELECTION_TIMEOUT_MS / 3};

static constexpr const char* SERVER_PORT = "6969";
//static constexpr uint SERVER_SNAPSHOT_PORT = 6970;
static constexpr const char* CLIENT_PORT = "6971";
//static constexpr uint CLIENT_SNAPSHOT_PORT = 6972;

// // max number of client connections
// static constexpr uint MAX_CLIENT_CONNS = 5;
// static constexpr uint MAX_BUFFER_SIZE = 200; // Size of the buffer that stores incoming data from the network

// // static constexpr std::string_view MY_IP_ADDRESS = "192...";
static constexpr int SERVER_BACKLOG = 10; // max # of connections allowed to wait on the incoming queue

// static constexpr size_t TASK_QUEUE_N = 1024;     // SPMC task queue depth
// static constexpr size_t COMP_QUEUE_N = 64;       // per-worker completion queue depth
// static constexpr size_t POOL_P       = 4;        // worker count, power of 2

// // Per-payload inline buffer baked into Task/Completion. Payloads up to this
// // size are zero-allocation; larger payloads fall back to a heap allocation.
// static constexpr uint32_t INLINE_PAYLOAD_BYTES = 256;

// Connection slab capacity. New accepts beyond this cap are closed immediately.
static constexpr size_t MAX_SERVER_CONNS = 512;

// The peer configuration is IDENTICAL on every node in the cluster. A peer's
// index in this array is its globally consistent NodeID. Each node lists
// ITSELF at index MY_ID using the empty placeholder "" in place of its own IP
// address; CreateNode skips that slot. Example for a 3-node cluster, as seen
// by every node (only MY_ID differs per node):
//
//   return std::array<const char*, 3>{
//       "",                  // index 0: NodeID 0 (placeholder when MY_ID == 0)
//       "1.2.3.4",           // index 1: NodeID 1
//       "1.2.3.5",           // index 2: NodeID 2
//   };
//
// The node with MY_ID == k must have "" at index k and real IPs elsewhere.
constexpr auto setup_peers() {
    return std::array<const char*, 1>{
        "", // index 0 == MY_ID (this node)
    };
}
