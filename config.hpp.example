#pragma once
/*
initial IP addresses provided for bootstrapping
*/
#include <cstddef>
#include <cstdint>
#include <string_view>
#include <sys/types.h>
static constexpr size_t CACHE_LINE_SIZE = 64;

static constexpr uint MIN_TIMEOUT_MS = 150;
static constexpr uint MAX_TIMEOUT_MS = 300;

static constexpr const char* SERVER_PORT = "6969";
//static constexpr uint SERVER_SNAPSHOT_PORT = 6970;
static constexpr const char* CLIENT_PORT = "6971";
//static constexpr uint CLIENT_SNAPSHOT_PORT = 6972;

// max number of client connections
static constexpr uint MAX_CLIENT_CONNS = 5;
static constexpr uint MAX_BUFFER_SIZE = 200; // Size of the buffer that stores incoming data from the network

// static constexpr std::string_view MY_IP_ADDRESS = "192...";
static constexpr int SERVER_BACKLOG = 10; // max # of connections allowed to wait on the incoming queue

static constexpr size_t TASK_QUEUE_N = 1024;     // SPMC task queue depth
static constexpr size_t COMP_QUEUE_N = 64;       // per-worker completion queue depth
static constexpr size_t POOL_P       = 4;        // worker count, power of 2

// Per-payload inline buffer baked into Task/Completion. Payloads up to this
// size are zero-allocation; larger payloads fall back to a heap allocation.
static constexpr uint32_t INLINE_PAYLOAD_BYTES = 256;

// Connection slab capacity. New accepts beyond this cap are closed immediately.
static constexpr size_t MAX_SERVER_CONNS = 1024;

constexpr auto setup_peers() {
    return std::array<std::string_view, 2>{
        "1.2.3", "4.5.6"
    };
}